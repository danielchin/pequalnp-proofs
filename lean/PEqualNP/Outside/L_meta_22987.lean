theorem PEqualNP.Outside.L_meta_22987 : (∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ 6 ∧ ∀ i j : Fin 6, C.eval (List.ofFn fun k : Fin 6 => decide (k = i ∨ k = j)) = (233016 : ℕ).testBit (6 * min i.val j.val + max i.val j.val))  := by
